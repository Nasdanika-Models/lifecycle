@Ecore(nsURI="https://lifecycle.models.nasdanika.org", nsPrefix="org.nasdanika.models.lifecycle")
@GenModel(
    featureDelegation="Dynamic",
    complianceLevel="21.0",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.lifecycle

import org.nasdanika.models.seal.SealedElement
import org.nasdanika.models.iam.Subject

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

/* ---- Definitions (the workflow side) ---- */

/*
 * A lifecycle definition: a named set of stages and the transitions
 * between them - a Jira workflow as data. Authored once, versioned,
 * shipped as a Maven artifact, referenced by many staged elements
 * (an editorial lifecycle, a capability maturity lifecycle, a
 * deprecation lifecycle). Reclaims and generalizes the Product
 * Management model's Lifecycle enumeration.
 */
class Lifecycle extends SealedElement {
    contains Stage[] stages
    contains Transition[] transitions
    /* Stages a new participant may enter directly (the Jira "create" transition targets). */
    refers Stage[] initial
}

/*
 * A stage definition. Hierarchical: a parent stage is a category
 * (Jira's To Do / In Progress / Done, generalized), so queries, access
 * conditions, and reports can bind at category level while sojourns
 * record the leaf.
 */
class Stage extends SealedElement {
    contains Stage[] children
}

/*
 * A permitted move between stages. An empty `from` makes the transition
 * global: available from any stage of the lifecycle. Guards are String
 * expressions over the element, the acting subject, and the environment;
 * a guard may demand signatures on the entering sojourn ("signed by a
 * subject engaged as approver"), which is the typed seam between this
 * model and seal.
 */
class Transition extends SealedElement {
    /* Source stages; empty means any stage (global transition). */
    refers Stage[] from
    refers Stage to
    /* Boolean expression; empty means unguarded. */
    String guard
}

/* ---- Occupancy (the record side) ---- */

/*
 * A period an element spends in a stage: dated, attributable, and - as a
 * SealedElement - signable, so approvals ride on the record that needed
 * them. An unset end means the element is currently in the stage.
 * Sojourns are never rewritten; a correction is a new sojourn.
 */
class Sojourn extends SealedElement {
    refers Stage stage
    Date start
    /* Unset while the element remains in the stage. */
    Date end
    /* Who moved the element in: a person, a service account, an agent. */
    refers Subject by
    /* Markdown rationale or note. */
    String comment
}

/* ---- Staged elements ---- */

/*
 * The aspect extension point: anything with a lifecycle. A domain class
 * extends this to acquire stage occupancy alongside access control,
 * sealing, and signatures. One element may participate in several
 * lifecycles (a document with an editorial and a compliance lifecycle);
 * its sojourn history is one list, its current stages one per lifecycle.
 * A Staged element with no sojourns simply has no lifecycle record yet,
 * so the aspect costs nothing until the first transition.
 */
abstract class Staged extends SealedElement {
    /* The lifecycles this element participates in. */
    refers Lifecycle[] lifecycles
    contains Sojourn[] sojourns
    refers derived Stage[] current get {
        // stages of open sojourns (no end date); at most one per lifecycle when well-formed
        null
    }
}

